# ─── Server ────────────────────────────────────────────────
PORT=8080
API_PREFIX=/api/v1
NODE_ENV=development
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# ─── Session cookie ────────────────────────────────────────
# lax    -> frontend and API on the same site (Vite proxy / same domain)   [recommended]
# none   -> frontend and API on different sites (requires HTTPS; COOKIE_SECURE=true)
COOKIE_SAMESITE=lax
# Defaults to true when NODE_ENV=production
# COOKIE_SECURE=true
# Optional, e.g. .visionaryitservices.com to share the cookie across subdomains
# COOKIE_DOMAIN=

# ─── Firebase Admin credentials ────────────────────────────
# Firebase Console -> Project settings -> Service accounts -> Generate new private key
#
# Option A: path to the downloaded JSON file
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
#
# Option B: inline values (keep the quotes and the literal \n sequences)
FIREBASE_PROJECT_ID=visionaryitservices-a0c6e
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@visionaryitservices-a0c6e.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADAN...\n-----END PRIVATE KEY-----\n"

# ─── SMTP (optional — emails are logged instead when unset) ─
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Visionary IT Services <noreply@visionaryitservices.com>"
# Where contact-form notifications go (defaults to SMTP_USER)
ADMIN_EMAIL=

# ─── Cloudinary (product images) ───────────────────────────
# Cloudinary Console -> Dashboard -> API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Images are stored under <folder>/products, <folder>/banners, ...
CLOUDINARY_FOLDER=visionary-it-services
