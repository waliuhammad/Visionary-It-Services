# Server Config
PORT=8080
API_PREFIX=/api/v1
NODE_ENV=development
# comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# Firebase credentials (either path to JSON or inline)
# If using a JSON file:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json

# If using inline env vars (replace literal \n in key with actual newlines or keep escaped and let env.js handle it):
FIREBASE_PROJECT_ID=visionary-it-services
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@visionary-it-services.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADAN...-----END PRIVATE KEY-----\n"

# SMTP settings for nodemailer
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password
SMTP_FROM="Visionary IT Services <noreply@visionaryitservices.com>"
