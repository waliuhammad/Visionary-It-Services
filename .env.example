# Copy to `.env` for local development, or `.env.production` for the Hostinger build.
# Vite embeds these values into the built JavaScript at build time, so never put secrets here.

# URL of the backend API.
# Leave empty in development (Vite proxies /api to http://localhost:8080).
# Production example: https://api.visionaryitservices.com/api/v1
VITE_API_BASE_URL=

# Firebase Web app config: Firebase Console -> Project settings -> General -> Your apps -> Web app
# (These are public identifiers, not secrets.)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=visionaryitservices-a0c6e.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=visionaryitservices-a0c6e
VITE_FIREBASE_STORAGE_BUCKET=visionaryitservices-a0c6e.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional — enables Google Analytics in production builds
VITE_FIREBASE_MEASUREMENT_ID=
